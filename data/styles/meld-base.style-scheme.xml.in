<style-scheme id="meld-base" name="Classic (Meld)" version="1.0" parent-scheme="classic">
  <author>Kai Willadsen</author>
  <description>Base color scheme for Meld highlighting</description>

  <!-- Meld -->
  <style name="meld:insert" background="#e6f4ea" foreground="#137333" line-background="#c2e7c9"/>
  <style name="meld:replace" background="#e8f0fe" foreground="#1a73e8" line-background="#d2e3fc"/>
  <style name="meld:conflict" background="#fce8e6" foreground="#c5221f" line-background="#fad2cf"/>
  <style name="meld:delete" background="#f1f3f4" foreground="#5f6368" line-background="#e8eaed"/>
  <style name="meld:error" background="#fef7e0" foreground="#b06000" line-background="#feefc3"/>
  <style name="meld:inline" background="#a8c7fa"/>
  <style name="meld:current-line-highlight" foreground="#333333" background="#rgba(26, 115, 232, 0.08)"/>
  <style name="meld:unknown-text" foreground="#888888"/>
  <style name="meld:syncpoint-outline" foreground="#555555"/>
  <style name="meld:current-chunk-highlight" background="#rgba(26, 115, 232, 0.15)"/>
  <style name="meld:overscroll" background="#rgba(50, 50, 50, 0.05)"/>
  <style name="meld:dimmed" foreground="#999999"/>
  <style name="map-overlay" background="#rgba(100, 100, 100, 0.2)"/>
</style-scheme>
