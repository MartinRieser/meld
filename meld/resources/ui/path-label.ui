<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkPopover" id="path_popover">
    <property name="focusable">1</property>
    <property name="child">
      <object class="GtkCenterBox">
        <property name="orientation">vertical</property>
        <property name="start-widget">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="vexpand">1</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="focusable">1</property>
                    <property name="label" translatable="1">Path</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="full_path_label">
                    <property name="focusable">1</property>
                    <property name="editable">0</property>
                    <property name="width-chars">60</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <property name="end-widget">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="halign">end</property>
                <property name="homogeneous">1</property>
                <style>
                  <class name="linked"/>
                </style>
                <child>
                  <object class="GtkButton">
                    <property name="label" translatable="1">Copy Path</property>
                    <property name="focus-on-click">0</property>
                    <property name="tooltip-text" translatable="1">Copy the full path</property>
                    <property name="action-name">widget.copy-full-path</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="label" translatable="1">Open Containing Folder</property>
                    <property name="focus-on-click">0</property>
                    <property name="tooltip-text" translatable="1">View the folder in file manager</property>
                    <property name="action-name">widget.open-folder</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <template class="PathLabel" parent="GtkMenuButton">
    <property name="popover">path_popover</property>
    <child>
      <placeholder/>
    </child>
  </template>
</interface>
