<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="NewDiffTab" parent="GtkBox">
    <property name="visible">True</property>
    <property name="can-focus">False</property>
    <property name="halign">center</property>
    <property name="valign">center</property>
    <property name="margin-start">24</property>
    <property name="margin-end">24</property>
    <property name="margin-top">24</property>
    <property name="margin-bottom">24</property>
    <child>
      <object class="GtkBox" id="vbox6">
        <property name="orientation">vertical</property>
        <property name="spacing">24</property>
        <property name="width-request">520</property>
        <child>
          <object class="GtkBox" id="header_box">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="label2">
                <property name="label" translatable="1">Meld</property>
                <property name="halign">center</property>
                <style>
                  <class name="new-diff-title"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="subtitle_label">
                <property name="label" translatable="1">Select a comparison type to begin</property>
                <property name="halign">center</property>
                <style>
                  <class name="new-diff-subtitle"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox7">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <child>
              <object class="GtkBox" id="hbox1">
                <property name="spacing">12</property>
                <property name="homogeneous">True</property>
                <child>
                  <object class="GtkToggleButton" id="button_type_file">
                    <property name="focusable">True</property>
                    <property name="receives-default">True</property>
                    <signal name="toggled" handler="on_button_type_toggled" swapped="no"/>
                    <child>
                      <object class="GtkBox" id="vbox1">
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkImage" id="image1">
                            <property name="icon-name">document-new-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label5">
                            <property name="label" translatable="1">File Diff</property>
                            <style>
                              <class name="new-diff-button-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <style>
                      <class name="new-diff-button"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="button_type_dir">
                    <property name="focusable">True</property>
                    <property name="receives-default">True</property>
                    <signal name="toggled" handler="on_button_type_toggled" swapped="no"/>
                    <child>
                      <object class="GtkBox" id="vbox2">
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkImage" id="image2">
                            <property name="icon-name">folder-new-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label6">
                            <property name="label" translatable="1">Folder Diff</property>
                            <style>
                              <class name="new-diff-button-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <style>
                      <class name="new-diff-button"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="button_type_vc">
                    <property name="focusable">True</property>
                    <property name="receives-default">True</property>
                    <signal name="toggled" handler="on_button_type_toggled" swapped="no"/>
                    <child>
                      <object class="GtkBox" id="vbox3">
                        <property name="orientation">vertical</property>
                        <property name="spacing">8</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkImage" id="image3">
                            <property name="icon-name">appointment-new-symbolic</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label7">
                            <property name="label" translatable="1">Version Control</property>
                            <style>
                              <class name="new-diff-button-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <style>
                      <class name="new-diff-button"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkNotebook" id="choosers_notebook">
                <property name="show-tabs">False</property>
                <property name="show-border">False</property>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="tab-fill">False</property>
                    <property name="child">
                      <object class="GtkBox" id="hbox2">
                        <property name="spacing">12</property>
                        <property name="homogeneous">True</property>
                        <child>
                          <placeholder/>
                        </child>
                        <child>
                          <placeholder/>
                        </child>
                        <child>
                          <placeholder/>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="position">1</property>
                    <property name="child">
                      <object class="GtkGrid" id="grid1">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">12</property>
                        <property name="column-homogeneous">True</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkLabel" id="label_file0">
                            <property name="label" translatable="1">First File</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_file1">
                            <property name="label" translatable="1">Second File</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_file2">
                            <property name="label" translatable="1">Third File</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="file_chooser0">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="pane">0</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_OPEN</property>
                            <property name="local-only">False</property>
                            <property name="dialog_label" translatable="1">Select First File</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="file_chooser1">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="pane">1</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_OPEN</property>
                            <property name="local-only">False</property>
                            <property name="dialog_label" translatable="1">Select Second File</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="file_chooser2">
                            <property name="visible">True</property>
                            <property name="sensitive">False</property>
                            <property name="can-focus">False</property>
                            <property name="pane">2</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_OPEN</property>
                            <property name="local-only">False</property>
                            <property name="dialog_label" translatable="1">Select Third File</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="file_three_way_checkbutton">
                            <property name="label" translatable="1">3-way comparison</property>
                            <property name="focusable">True</property>
                            <property name="use-underline">True</property>
                            <signal name="toggled" handler="on_three_way_checkbutton_toggled" swapped="no"/>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="position">1</property>
                    <property name="child">
                      <object class="GtkGrid" id="grid2">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">12</property>
                        <property name="column-homogeneous">True</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkLabel" id="label_dir0">
                            <property name="label" translatable="1">First Folder</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_dir1">
                            <property name="label" translatable="1">Second Folder</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_dir2">
                            <property name="label" translatable="1">Third Folder</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="dir_chooser0">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="pane">0</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER</property>
                            <property name="dialog_label" translatable="1">Select First Folder</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="dir_chooser1">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="pane">1</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER</property>
                            <property name="dialog_label" translatable="1">Select Second Folder</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="dir_chooser2">
                            <property name="visible">True</property>
                            <property name="sensitive">False</property>
                            <property name="can-focus">False</property>
                            <property name="pane">2</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER</property>
                            <property name="dialog_label" translatable="1">Select Third Folder</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="dir_three_way_checkbutton">
                            <property name="label" translatable="1">3-way comparison</property>
                            <property name="focusable">True</property>
                            <property name="use-underline">True</property>
                            <signal name="toggled" handler="on_three_way_checkbutton_toggled" swapped="no"/>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="position">2</property>
                    <property name="child">
                      <object class="GtkGrid" id="grid3">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">12</property>
                        <property name="column-homogeneous">True</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkLabel" id="label_vc0">
                            <property name="label" translatable="1">Version-Controlled Folder</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="chooser-label"/>
                            </style>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="MeldFileButton" id="vc_chooser0">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="pane">0</property>
                            <property name="action">GTK_FILE_CHOOSER_ACTION_SELECT_FOLDER</property>
                            <property name="dialog_label" translatable="1">Select A Version-Controlled Folder</property>
                            <signal name="file-selected" handler="on_file_selected" swapped="no"/>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbuttonbox2">
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>
            <property name="halign">center</property>
            <property name="margin-top">12</property>
            <child>
              <object class="GtkButton" id="button_new_blank">
                <property name="label" translatable="1">Blank comparison</property>
                <property name="sensitive">False</property>
                <property name="focusable">True</property>
                <property name="receives-default">True</property>
                <property name="use-underline">True</property>
                <signal name="clicked" handler="on_button_new_blank_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_compare">
                <property name="label" translatable="1">Compare</property>
                <property name="sensitive">False</property>
                <property name="focusable">True</property>
                <property name="receives-default">True</property>
                <property name="use-underline">True</property>
                <signal name="clicked" handler="on_button_compare_clicked" swapped="no"/>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
